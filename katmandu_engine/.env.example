# ============================================
# KATMANDU ENGINE - ENVIRONMENT CONFIGURATION
# ============================================
# Bu dosyayi .env olarak kopyalayin ve API key'lerinizi ekleyin
# cp .env.example .env

# ============================================
# SERVER AYARLARI
# ============================================
KATMANDU_HOST=0.0.0.0
KATMANDU_PORT=8000
KATMANDU_DEBUG=false

# ============================================
# LAYER AYARLARI
# ============================================
# Gercek API mi mock mu kullanilacak
USE_REAL_API=true

# Varsayilan LLM yogunlugu (1-7 arasi rahip)
DEFAULT_INTENSITY=5

# ============================================
# LLM PROVIDER API KEYS
# ============================================
# En az bir API key gerekli. Diger provider'lar mock olarak calisir.

# CLAUDE (Anthropic) - Etik Boyutu
# https://console.anthropic.com/
CLAUDE_API_KEY=sk-ant-api03-xxxxxxxxxxxxx
CLAUDE_MODEL=claude-sonnet-4-20250514

# OPENAI (GPT) - Yaraticilik Boyutu
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o

# GEMINI (Google) - Analiz Boyutu
# https://aistudio.google.com/apikey
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_MODEL=gemini-2.0-flash

# MISTRAL - Lojistik Boyutu
# https://console.mistral.ai/
MISTRAL_API_KEY=xxxxxxxxxxxxxxxxxxxxx
MISTRAL_MODEL=mistral-large-latest

# DEEPSEEK - Kod Boyutu
# https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_MODEL=deepseek-chat

# LLAMA (Together AI) - Bilgelik Boyutu
# https://api.together.xyz/settings/api-keys
LLAMA_API_KEY=xxxxxxxxxxxxxxxxxxxxx
LLAMA_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo

# Alternatif: Groq
# https://console.groq.com/keys
# GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxx

# MINIMAX - Sentez Boyutu
# https://www.minimax.chat/
MINIMAX_API_KEY=xxxxxxxxxxxxxxxxxxxxx
MINIMAX_MODEL=MiniMax-Text-01

# ============================================
# N8N ENTEGRASYONU (Opsiyonel)
# ============================================
N8N_HOST=http://localhost:5678
N8N_API_KEY=

# ============================================
# OZEL BASE URL'LER (Opsiyonel)
# ============================================
# Ozel proxy veya self-hosted API'ler icin
# CLAUDE_BASE_URL=https://custom-claude-api.com
# OPENAI_BASE_URL=https://custom-openai-api.com
