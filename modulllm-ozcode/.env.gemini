# MODULllm.com - Gemini Ultra Configuration

# Gemini API
GEMINI_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX  # Buraya kendi key'ini ekle!
GEMINI_MODEL=gemini-ultra
GEMINI_PRO_MODEL=gemini-pro
GEMINI_VISION_MODEL=gemini-pro-vision

# 111 Akıl Configuration
ENABLE_111_AKIL=true
ORIGINAL_11_AKIL=true
GEMINI_PERSPECTIVES_COUNT=10  # Gemini'den kaç perspektif (1-100)

# Gemini Settings
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_TOKENS=8192
GEMINI_TOP_P=0.95
GEMINI_TOP_K=40

# Safety Settings (production'da ayarla)
GEMINI_SAFETY_LEVEL=BLOCK_NONE  # BLOCK_NONE, BLOCK_FEW, BLOCK_SOME, BLOCK_MOST

# Performance
GEMINI_TIMEOUT=60
GEMINI_MAX_RETRIES=3
GEMINI_CONCURRENT_REQUESTS=10

# Cost Management (opsiyonel)
GEMINI_DAILY_LIMIT=10000  # Günlük max request
GEMINI_COST_TRACKING=true

# Integration
COMBINE_WITH_MINIMAX=true
COMBINE_WITH_LOCAL_LLMS=true
