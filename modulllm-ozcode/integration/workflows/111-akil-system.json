      "position": [250, 300]
    },
    {
      "parameters": {
        "jsCode": "const soru = $input.item.json.soru;\nconst context = $input.item.json.context || '';\n\nreturn {\n  soru,\n  context,\n  timestamp: new Date().toISOString(),\n  platform: 'MODULllm.com'\n};"
      },
      "id": "code-1",
      "name": "Parse Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [450, 300]
    },
    {
      "parameters": {
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleAiApi",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-ultra:generateContent",
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"contents\": [{\n    \"role\": \"user\",\n    \"parts\": [{\n      \"text\": \"Yaratıcı ve vizyoner perspektiften değerlendir: {{ $json.soru }}\"\n    }]\n  }]\n}",
        "options": {}
      },
      "id": "http-1",
      "name": "Gemini Ultra - Creative Vision",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [650, 100]
    },
    {
      "parameters": {
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "resource": "chat",
        "model": "gpt-4-turbo-preview",
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "Sen analitik ve veri odaklı bir AI'sın. Derinlemesine analiz yap."
            },
            {
              "role": "user",
              "content": "={{ $json.soru }}"
