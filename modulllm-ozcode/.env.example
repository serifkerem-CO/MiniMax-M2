# MODULllm.com - Environment Configuration

# Platform
PLATFORM_NAME="MODULllm.com"
OZ_KOD_MODE=true
ENVIRONMENT=production

# DEAVAEM Gemi
GEMI_ENDPOINT=http://gemi.modulllm.com:8000
GEMI_API_KEY=your_gemi_api_key_here

# LLM Endpoints (Self-hosted)
MINIMAX_ENDPOINT=http://gemi.modulllm.com:8000/v1
LOCAL_LLM_1=http://localhost:11434/api  # Ollama
LOCAL_LLM_2=http://localhost:5000/v1    # vLLM

# Öz Veritabanı
OZ_DB_PATH=./data/modulllm_oz.db

# Redis
REDIS_URL=redis://localhost:6379/0

# API Keys (if needed)
API_KEY_SECRET=your_secret_key_here

# Metrics & Monitoring
ENABLE_METRICS=true
LOG_LEVEL=INFO

# 11 Akıl Configuration
AKIL_COUNT=11
SENTEZ_AKIL_ENABLED=true
PARALLEL_EXECUTION=true

# Gemi Configuration
SU_SOGUTMA_THRESHOLD=30  # °C
GPU_MAX_TEMP=80          # °C
