# MiniMax API Configuration
# Get your API key from: https://platform.minimax.io/

MINIMAX_API_KEY=your_api_key_here
MINIMAX_GROUP_ID=your_group_id_here
MINIMAX_API_BASE=https://api.minimax.chat/v1/text/chatcompletion_v2

# Model Parameters (MiniMax-M2 recommended)
TEMPERATURE=1.0
TOP_P=0.95
TOP_K=40
MAX_TOKENS=1024

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Security
SECRET_KEY=your_secret_key_here_change_in_production

# CORS (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,https://modulllm.com

# Redis (optional, for caching)
REDIS_URL=redis://localhost:6379/0

# Database (optional)
DATABASE_URL=postgresql://user:password@localhost/12inci

# Logging
LOG_LEVEL=INFO
